{
  "name": "satu-generus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx src/lib/db/run-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx src/lib/db/seed.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@lucide/svelte": "^1.52.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/leaflet": "^1.9.22",
    "bcryptjs": "^3.0.3",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "xlsx": "^0.18.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "engines": {
    "node": ">=22.17",
    "npm": ">=10"
  },
  "overrides": {
    "runed": {
      "@sveltejs/kit": "$@sveltejs/kit"
    },
    "drizzle-kit": {
      "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0"
    }
  }
}
