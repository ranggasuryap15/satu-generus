# @file .env.example
# @purpose Template konfigurasi environment variables Satu Generus
# @usedBy Developer saat inisialisasi lingkungan lokal dan deployment server
# @dependencies N/A
# @publicFunctions N/A
# @sideEffects Dokumen referensi konfigurasi environment

# Port dan Host
PORT=5173
HOST=0.0.0.0

# Public Origin server (Wajib jika di-deploy ke server remote VPS dengan IP/domain & port tertentu)
# Contoh di VPS: ORIGIN=http://169.58.223.6:21105
ORIGIN=http://localhost:5173

# Database SQLite path
DATABASE_URL=./data/sqlite.db

# Kunci Enkripsi AES-256-GCM (Wajib 32 karakter atau 64-karakter hex string)
ENCRYPTION_KEY=satu_generus_secret_key_32bytes!

